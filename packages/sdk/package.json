{
  "name": "@peelbtc/sdk",
  "version": "0.1.0",
  "description": "Full Peel SDK — A Payments Engine for Every Layer",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@peelbtc/core": "workspace:*",
    "@peelbtc/types": "workspace:*",
    "@rsksmart/flyover-sdk": "^1.9.1",
    "@stacks/transactions": "^7.4.0",
    "viem": "^2.49.0"
  },
  "devDependencies": {
    "dotenv": "^17.4.2"
  }
}
