{
  "name": "@peelbtc/types",
  "version": "0.1.0-alpha.1",
  "description": "Publishable type interfaces for the Peel protocol",
  "license": "MIT",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --passWithNoTests",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ECBSJ/Peel.git",
    "directory": "packages/types"
  },
  "keywords": [
    "bitcoin",
    "btc",
    "stacks",
    "sbtc",
    "rootstock",
    "bob",
    "citrea",
    "brid",
    "routing",
    "payments",
    "l2"
  ],
  "publishConfig": {
    "access": "public"
  }
}
